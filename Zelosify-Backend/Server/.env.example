DATABASE_URL="postgresql://postgres:password@localhost:5432/zelosify_db?schema=app"

JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your_encryption_key_32_bytes_hex
NODE_ENV=development
ENABLE_DEV_LOGIN=true

# Storage Configuration
STORAGE_PROVIDER=aws

# AWS S3 Configuration
S3_AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=your_aws_access_key
S3_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your_s3_bucket_name

# AI Recommendation Agent (Groq / Gemini OpenAI-compatible)
GROQ_API_KEY=your_groq_or_gemini_api_key
GROQ_MODEL=qwen/qwen3.8-27b
AI_PROFILE_TIMEOUT_MS=10000

# Keycloak Configuration (Optional in dev mode when using dev-login)
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=Zelosify
KEYCLOAK_CLIENT_ID=dynamic-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_RS256_SIG=your_keycloak_public_key

SESSION_SECRET=your_session_secret
PORT=5000
FRONTEND_URL=http://localhost:5173
